#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

cat <<'MSG'
[update-template] Updating crossroot template via copier...

  This applies upstream template changes to this repo.
  Review every changed file before committing — especially:
    • pyproject.toml, noxfile.py (control-plane)
    • scripts/ (repo orchestration)
    • .github/workflows/ (CI)

  Files you own and should not conflict:
    • docs/agent-src/    application-specific agent docs
    • python/, typescript/, java/    application code

MSG

# If the template was generated from a local directory (i.e. this repo is
# exercising an in-development crossroot checkout), update against that
# checkout's HEAD rather than its latest tag — otherwise copier would revert
# to the most recent tagged release and ignore unreleased local changes.
src_path="$(grep -oE "_src_path:[[:space:]]*'?[^,'}]+" .copier-answers.yml | sed -E "s/_src_path:[[:space:]]*'?//" | head -1)"
vcs_ref_args=()
if [ -n "$src_path" ] && [ -d "$src_path" ]; then
  vcs_ref_args=(--vcs-ref=HEAD)
fi

uvx copier update --trust --defaults "${vcs_ref_args[@]}"
